# Copy thành .env để chạy local (pnpm start:dev). Xem docs/design/07-conventions.md §6.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
LOG_PRETTY=true

DATABASE_URL=postgres://meetnote:meetnote@localhost:5432/meetnote
DATABASE_POOL_MAX=10

REDIS_URL=redis://localhost:6379

# Auth (M1). Secret dưới đây CHỈ dùng cho dev local. Sinh secret thật: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=10
