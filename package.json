{
  "name": "meetnote",
  "version": "0.1.0",
  "description": "MeetNote — biên bản họp theo nhóm (project học NestJS)",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:worker": "nest start --watch --entryFile worker",
    "start:prod": "node dist/main.js",
    "start:prod:worker": "node dist/worker.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --type-aware src/ test/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env dist/scripts/migrate.js",
    "db:studio": "drizzle-kit studio",
    "openapi:export": "node dist/scripts/export-openapi.js",
    "bench:meeting-list": "node scripts/bench/meeting-list.mjs",
    "bench:transcript-search": "node scripts/bench/transcript-search.mjs",
    "test:whisper": "pnpm build && node scripts/whisper-check.mjs",
    "smoke:pipeline": "node scripts/pipeline-smoke.mjs",
    "report:backfill": "node scripts/report-backfill.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/platform-socket.io": "12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "12.1.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.13",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@nestjs/testing": "^12.1.3",
    "@testcontainers/postgresql": "^12.2.0",
    "@testcontainers/redis": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.4",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
