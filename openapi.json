{
  "openapi": "3.0.0",
  "paths": {
    "/health/live": {
      "get": {
        "description": "Không kiểm tra phụ thuộc: DB chết không phải lý do để orchestrator restart api.",
        "operationId": "Health_live",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthLiveResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {}
        ],
        "summary": "Liveness — tiến trình còn sống.",
        "tags": [
          "Health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "Kiểm tra Postgres (`SELECT 1`) và Redis (`PING`), mỗi kiểm tra timeout 1 giây.",
        "operationId": "Health_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReadyResponseDto"
                }
              }
            }
          },
          "503": {
            "description": "Ít nhất một phụ thuộc không phản hồi.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReadyResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {}
        ],
        "summary": "Readiness — sẵn sàng nhận traffic.",
        "tags": [
          "Health"
        ]
      }
    },
    "/v1/auth/register": {
      "post": {
        "description": "Email trùng (không phân biệt hoa thường) trả 409 `AUTH_EMAIL_TAKEN`.",
        "operationId": "Auth_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthTokensResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Dữ liệu không hợp lệ (`VALIDATION_FAILED`, `INVALID_CURSOR`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "409": {
            "description": "Xung đột trạng thái hoặc dữ liệu trùng (`CONFLICT` hoặc mã cụ thể).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {}
        ],
        "summary": "Đăng ký tài khoản mới và đăng nhập luôn.",
        "tags": [
          "Auth"
        ]
      }
    },
    "/v1/auth/login": {
      "post": {
        "description": "Sai email hoặc sai mật khẩu đều trả CÙNG 401 `AUTH_INVALID_CREDENTIALS`.",
        "operationId": "Auth_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthTokensResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Dữ liệu không hợp lệ (`VALIDATION_FAILED`, `INVALID_CURSOR`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Thiếu hoặc sai access token (`UNAUTHENTICATED`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {}
        ],
        "summary": "Đăng nhập bằng email + mật khẩu.",
        "tags": [
          "Auth"
        ]
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "description": "Mỗi refresh token chỉ dùng được một lần. Dùng lại token cũ trong 10 giây (hai tab\nrefresh cùng lúc) → 401 `AUTH_REFRESH_TOKEN_ROTATED`; quá 10 giây → coi là bị đánh cắp,\nthu hồi cả phiên và trả 401 `AUTH_REFRESH_TOKEN_REUSED`.",
        "operationId": "Auth_refresh",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthTokensResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Dữ liệu không hợp lệ (`VALIDATION_FAILED`, `INVALID_CURSOR`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Thiếu hoặc sai access token (`UNAUTHENTICATED`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {}
        ],
        "summary": "Đổi refresh token lấy cặp token mới (xoay vòng).",
        "tags": [
          "Auth"
        ]
      }
    },
    "/v1/auth/logout": {
      "post": {
        "description": "Access token của phiên này bị từ chối ngay ở request tiếp theo; refresh token hết dùng được.",
        "operationId": "Auth_logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Đã thu hồi phiên."
          },
          "401": {
            "description": "Thiếu hoặc sai access token (`UNAUTHENTICATED`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Đăng xuất phiên hiện tại.",
        "tags": [
          "Auth"
        ]
      }
    },
    "/v1/auth/logout-all": {
      "post": {
        "operationId": "Auth_logoutAll",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Đã thu hồi mọi phiên."
          },
          "401": {
            "description": "Thiếu hoặc sai access token (`UNAUTHENTICATED`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Đăng xuất khỏi MỌI thiết bị (thu hồi mọi phiên của tài khoản, kể cả phiên hiện tại).",
        "tags": [
          "Auth"
        ]
      }
    }
  },
  "info": {
    "title": "MeetNote API",
    "description": "API biên bản họp theo nhóm.\n\n- Lỗi luôn có dạng `{ error: { code, message, details?, requestId } }`.\n- Danh sách phân trang cursor: `{ data, nextCursor }`, query `cursor` + `limit`.\n- Mọi response có header `x-request-id`.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Health",
      "description": "Kiểm tra tình trạng tiến trình"
    },
    {
      "name": "Auth",
      "description": "Đăng ký, đăng nhập, phiên đăng nhập"
    },
    {
      "name": "Organizations",
      "description": "Tổ chức, thành viên, lời mời, audit log"
    },
    {
      "name": "Channels",
      "description": "Kênh và thành viên kênh"
    },
    {
      "name": "Meetings",
      "description": "Upload, cuộc họp, transcript, tóm tắt, tìm kiếm"
    },
    {
      "name": "Reports",
      "description": "Báo cáo tuần của kênh"
    },
    {
      "name": "Notifications",
      "description": "Thông báo trong ứng dụng"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Access token lấy từ `POST /v1/auth/login`."
      }
    },
    "schemas": {
      "HealthLiveResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Luôn là `ok` nếu tiến trình trả lời được.",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "DependencyChecksDto": {
        "type": "object",
        "properties": {
          "database": {
            "type": "string",
            "description": "Kết quả `SELECT 1` tới Postgres.",
            "enum": [
              "up",
              "down"
            ]
          },
          "redis": {
            "type": "string",
            "description": "Kết quả `PING` tới Redis.",
            "enum": [
              "up",
              "down"
            ]
          }
        },
        "required": [
          "database",
          "redis"
        ]
      },
      "HealthReadyResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "description": "`ok` khi mọi phụ thuộc đều `up`; ngược lại `error` và HTTP 503.",
            "enum": [
              "error",
              "ok"
            ],
            "type": "string"
          },
          "checks": {
            "$ref": "#/components/schemas/DependencyChecksDto"
          }
        },
        "required": [
          "status",
          "checks"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Email đăng nhập. Không phân biệt hoa thường khi so trùng.",
            "example": "an.nguyen@example.com",
            "maxLength": 254,
            "format": "email"
          },
          "password": {
            "type": "string",
            "description": "Mật khẩu 8–128 ký tự. Không ép quy tắc \"phải có số/ký tự đặc biệt\" (theo NIST SP 800-63B):\nđộ dài quan trọng hơn độ phức tạp. Không trim — khoảng trắng là một phần của mật khẩu.",
            "example": "mot-cau-mat-khau-dai",
            "minLength": 8,
            "maxLength": 128
          },
          "displayName": {
            "type": "string",
            "description": "Tên hiển thị.",
            "example": "Nguyễn Văn An",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "email",
          "password",
          "displayName"
        ]
      },
      "AuthTokensResponseDto": {
        "type": "object",
        "properties": {
          "tokenType": {
            "description": "Luôn là `Bearer`: gửi `Authorization: Bearer <accessToken>`.",
            "enum": [
              "Bearer"
            ],
            "type": "string"
          },
          "accessToken": {
            "type": "string",
            "description": "JWT sống ngắn (mặc định 15 phút)."
          },
          "accessTokenExpiresAt": {
            "type": "string",
            "description": "Thời điểm access token hết hạn (ISO 8601, UTC).",
            "example": "2026-10-13T08:15:00.000Z"
          },
          "refreshToken": {
            "type": "string",
            "description": "Dùng một lần cho `POST /v1/auth/refresh`; mỗi lần refresh nhận token mới.",
            "example": "q3Jt0b6Q2l3Zc0p9QpXb5m1q8D0yJ4dA7m2N5r1sT6w"
          },
          "refreshTokenExpiresAt": {
            "type": "string",
            "description": "Thời điểm refresh token hết hạn (ISO 8601, UTC).",
            "example": "2026-11-12T08:00:00.000Z"
          }
        },
        "required": [
          "tokenType",
          "accessToken",
          "accessTokenExpiresAt",
          "refreshToken",
          "refreshTokenExpiresAt"
        ]
      },
      "ErrorDetailDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "Đường dẫn tới field lỗi (dạng chấm cho field lồng nhau).",
            "example": "members.0.role"
          },
          "message": {
            "type": "string",
            "example": "role must be one of the following values: admin, member"
          }
        },
        "required": [
          "message"
        ]
      },
      "ErrorBodyDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Mã lỗi máy đọc được — client rẽ nhánh theo mã này, không theo `message`.",
            "example": "VALIDATION_FAILED"
          },
          "message": {
            "type": "string",
            "description": "Mô tả cho người đọc. Có thể thay đổi bất kỳ lúc nào."
          },
          "details": {
            "description": "Chi tiết từng field (chỉ có với lỗi validate).",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ErrorDetailDto"
            }
          },
          "requestId": {
            "type": "string",
            "description": "Trùng với header `x-request-id`, dùng để tra log.",
            "example": "4f7d1c3e-2a9b-4c1d-8e6f-0a1b2c3d4e5f"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBodyDto"
          }
        },
        "required": [
          "error"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "an.nguyen@example.com",
            "maxLength": 254,
            "format": "email"
          },
          "password": {
            "type": "string",
            "description": "Không kiểm tra độ dài tối thiểu ở đây (tài khoản cũ có thể có quy tắc khác),\nnhưng vẫn chặn chuỗi quá dài trước khi tới argon2.",
            "example": "mot-cau-mat-khau-dai",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Refresh token nhận từ lần đăng nhập / refresh gần nhất. Mỗi token chỉ dùng được MỘT lần.",
            "example": "q3Jt0b6Q2l3Zc0p9QpXb5m1q8D0yJ4dA7m2N5r1sT6w"
          }
        },
        "required": [
          "refreshToken"
        ]
      }
    }
  },
  "security": [
    {
      "bearer": []
    }
  ]
}
