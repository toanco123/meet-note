# Copy thành .env để chạy local (pnpm start:dev). Xem docs/design/07-conventions.md §6.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
LOG_PRETTY=true

# App kết nối bằng user đăng nhập riêng, không superuser (M11 B6) — `pnpm db:migrate` tạo user này.
DATABASE_URL=postgres://meetnote_api_login:dev-api-password@localhost:5432/meetnote
# Worker local: DATABASE_URL=postgres://meetnote_worker_login:dev-worker-password@localhost:5432/meetnote pnpm start:worker
# `pnpm db:migrate`: chạy bằng CHỦ schema + tạo / cập nhật user của api, worker. Chỉ cho local.
MIGRATION_DATABASE_URL=postgres://meetnote:meetnote@localhost:5432/meetnote
DB_API_PASSWORD=dev-api-password
DB_WORKER_PASSWORD=dev-worker-password
DATABASE_POOL_MAX=10

REDIS_URL=redis://localhost:6379

# Auth (M1). Secret dưới đây CHỈ dùng cho dev local. Sinh secret thật: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=10

# Object storage S3 (M5). Local dùng RustFS trong compose (cổng 9000; console http://localhost:9001).
REALTIME_CORS_ORIGINS=http://localhost:3000
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=meetnote
S3_ACCESS_KEY_ID=meetnote
S3_SECRET_ACCESS_KEY=meetnote-secret
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET=true

# Pipeline (M6): binary trong PATH (macOS: brew install ffmpeg whisper-cpp)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
